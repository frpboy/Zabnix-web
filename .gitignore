# ───────────────────────────────────────────────────────────────
#  Zabnix Web — Next.js App
#  .gitignore — keep the repo clean, never commit secrets or build artefacts
# ───────────────────────────────────────────────────────────────

# ─── Next.js ────────────────────────────────────────────────────
.next/
out/
next-env.d.ts

# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Build outputs ──────────────────────────────────────────────
build/
dist/
*.tsbuildinfo

# ─── Environment / secrets ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ─── Testing ────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Vercel ─────────────────────────────────────────────────────
.vercel

# ─── OS generated ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor / IDE ───────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ─── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Package manager lock (keep only one) ────────────────────────
# We use npm — ignore yarn / pnpm locks
yarn.lock
pnpm-lock.yaml

# ─── Misc ───────────────────────────────────────────────────────
.cache/
tmp/
temp/
